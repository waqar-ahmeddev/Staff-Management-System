						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"employeeId\": \"6aa17a6151b7e645fcdb6858\",\n  \"month\": \"September\",\n  \"year\": 2026,\n  \"baseSalary\": 80000,\n  \"allowances\": {\n    \"medical\": 5000,\n    \"conveyance\": 3000,\n    \"other\": 2000\n  },\n  \"deductions\": {\n    \"tax\": 4000,\n    \"unpaidLeaves\": 1000,\n    \"other\": 0\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/payroll/generate",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "payroll", "generate"]
						}
					},
					"response": []
